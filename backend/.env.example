# Private TrustCheck AI test using the existing andlahore-5145 Foundry resource.
# Set these on the backend host, NOT in GitHub or the Android APK.
AZURE_OPENAI_ENDPOINT=https://andlahore-5145-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=piku-chat
# Confirm supported API version for this deployment before live testing.
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=SET_SECURELY_NOT_IN_GIT
TRUSTCHECK_TEST_TOKEN=PRIVATE_TEST_TOKEN_ONLY
